# Production Environment Configuration Example
# Copy this file to '.env' in production and update the values.

# Security & Host Configuration
DEBUG=False
SECRET_KEY=your-production-secret-key-change-this
ALLOWED_HOSTS=sim2real.nitk.ac.in,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://sim2real.nitk.ac.in,http://localhost:5173,http://127.0.0.1:5173

# SSL & Cookie Security (set to True if using HTTPS)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Email Credentials & Server Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=sim2real.helpdesk@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=sim2real.helpdesk@gmail.com
SERVER_EMAIL=sim2real.helpdesk@gmail.com
ORGANIZER_EMAIL=sim2real.helpdesk@gmail.com

# Recaptcha & Third Party Keys
RECAPTCHA_SECRET_KEY=your_google_recaptcha_secret_key